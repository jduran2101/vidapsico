---
import { getCollection } from "astro:content";

const servicios = (await getCollection("servicios")).sort(
    (a, b) => a.data.orden - b.data.orden,
);
---

{
    servicios.map(uno =>
        <article class="area">
            <a href={`/terapia/${uno.id}/`}>
                <img
                    src={uno.data.imagen}
                    alt={`Terapia online: ${uno.data.titulo}`}
                    loading="lazy"
                    width="320"
                    height="400"
                />
                <div class="descripcion">
                    <h2>{uno.data.titulo}</h2>
                    <p>{uno.data.resumen}</p>
                    <span class="ver-mas">Ver más</span>
                </div>
            </a>
        </article>
    )
}

<style>
  .area {
    padding: 2rem 1rem;
    width: 320px;
    height: 400px;
    position: relative;
    display: flex;
    justify-content: flex-end;
    box-shadow: 0px 7px 10px rgba(0, 0, 0, 0.5);
    transition: 0.5s ease-in-out;
    animation: appear linear;
    animation-timeline: view();
    animation-range: entry 0% cover 40%;
  }
  @keyframes appear {
    from {
      opacity: 0;
      /*scale: 0.5;*/
      transform: translateX(-100px);
    }
    to {
      opacity: 1;
      /*scale: 1;*/
      transform: translateX(0px);
    }
    
  }



  .area a {
    position: absolute;
    inset: 0;
    z-index: 3;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 2rem 1rem;
    text-decoration: none;
  }
  .area img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    top: 0;
    left: 0;
  }
  .area .descripcion {
    position: relative;
    z-index: 3;
    color:#fff;
    transform: translateY(0);
    transition: 0.5s all;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
  }
  .area:hover .descripcion {
    transform: translateY(-6px);
  }
  .area .ver-mas {
    display: block;
    text-align: center;
    font-size: 15px;
    font-weight: 500;
    color: #fff;
    border: 2px solid #fff;
    border-radius: 12px;
    padding: 6px 18px;
    width: fit-content;
    margin: 0 auto;
  }
  .area .descripcion p  {
    font-size: 18px;
    font-weight: bold;
    text-align: center;
    line-height: 30px;
    margin-top: 8px;
    margin-bottom: 20px;
    color: #fff;
  }
    
  .area .descripcion h2 {
    margin: 0;
    text-decoration: underline;
    text-decoration-color: #fff;
    text-decoration-thickness:4px ;
    text-align: center;
    padding-bottom: 10px;
  }
  .area:before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, rgba(0, 0, 0, 0.15) 30%, rgba(28, 88, 76, 0.9));
    z-index: 2;
    transition: 0.5s all;
    opacity: 1;
  }
  .area:hover:before {
    background: linear-gradient(to bottom, rgba(0, 176, 155, 0.5), rgba(150, 201, 61, 1));
  }
</style>