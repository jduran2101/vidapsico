<style>
  .whatsapp-wrapper {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 999;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .whatsapp-btn {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    background: #25D366;
    color: #fff;
    text-decoration: none;
    border-radius: 50px;
    padding: 10px 20px 10px 10px;
    box-shadow: 0 4px 20px rgba(37, 211, 102, 0.45);
    transition: box-shadow 0.3s ease, transform 0.25s ease, padding 0.3s ease, border-radius 0.3s ease;
    overflow: visible;
  }

  /* Collapsed on mobile by default → only circle */
  @media (max-width: 600px) {
    .whatsapp-btn {
      padding: 10px;
      border-radius: 50%;
    }
    .whatsapp-label {
      display: none;
    }
  }

  .whatsapp-btn:hover {
    box-shadow: 0 6px 28px rgba(37, 211, 102, 0.6);
    transform: translateY(-3px) scale(1.04);
  }

  /* ---- Pulse rings ---- */
  .pulse-ring {
    position: absolute;
    inset: 0;
    border-radius: 50px;
    border: 2.5px solid rgba(37, 211, 102, 0.7);
    animation: waPulse 2.4s ease-out infinite;
    pointer-events: none;
  }

  @media (max-width: 600px) {
    .pulse-ring {
      border-radius: 50%;
    }
  }

  .pulse-ring--2 {
    animation-delay: 0.8s;
  }

  @keyframes waPulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    80%,
    100% {
      transform: scale(1.55);
      opacity: 0;
    }
  }

  /* ---- Icon circle ---- */
  .whatsapp-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    background: #fff;
    border-radius: 50%;
    flex-shrink: 0;
    box-shadow: inset 0 0 0 1.5px rgba(0,0,0,0.06);
    transition: transform 0.25s ease;
  }

  .whatsapp-btn:hover .whatsapp-icon {
    transform: rotate(8deg) scale(1.08);
  }

  .whatsapp-icon svg {
    width: 28px;
    height: 28px;
  }

  /* ---- Label ---- */
  .whatsapp-label {
    font-family: 'Outfit Variable', sans-serif;
    font-weight: 600;
    font-size: 0.92rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0,0,0,0.15);
  }
</style>
