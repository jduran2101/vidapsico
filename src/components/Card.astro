---
interface Props {
    svg: string;
    title: string;
    body: string;
    href?: string;
}

const { svg, title, body, href = "/areas/" } = Astro.props;
---

<article class="service-card">
    <a href={href} class="card-link">
        <div class="icon-wrap">
            <img src={svg} alt="" width="44" height="44" loading="lazy" />
        </div>
        <div class="content">
            <h3>{title}</h3>
            <p>{body}</p>
            <span class="more">Ver más →</span>
        </div>
    </a>
    <div class="fill" aria-hidden="true"></div>
</article>

<style>
    .service-card {
        position: relative;
        background: #fff;
        border-radius: 20px;
        width: 280px;
        max-width: 100%;
        min-height: 280px;
        box-sizing: border-box;
        display: flex;
        overflow: hidden;
        cursor: pointer;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        box-shadow: 0 2px 12px rgba(28,88,76,0.07);
    }

    /* el enlace ocupa toda la tarjeta: área clicable completa, un solo enlace */
    .card-link {
        position: relative;
        z-index: 1;
        flex: 1;
        padding: 32px 24px 28px;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 16px;
        text-decoration: none;
    }

    .service-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 16px 40px rgba(28,88,76,0.16);
    }

    /* fill slides up on hover */
    .fill {
        position: absolute;
        inset: 0;
        background: #1c584c;
        transform: translateY(100%);
        transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        z-index: 0;
        border-radius: 20px;
    }

    .service-card:hover .fill {
        transform: translateY(0);
    }

    /* ── ICON ── */
    .icon-wrap {
        position: relative;
        z-index: 1;
        width: 72px;
        height: 72px;
        background: rgba(28,88,76,0.08);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background 0.3s ease;
        flex-shrink: 0;
    }

    .service-card:hover .icon-wrap {
        background: rgba(139,253,44,0.15);
    }

    .icon-wrap img {
        width: 44px;
        height: 44px;
    }

    /* ── CONTENT ── */
    .content {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
        flex: 1;
    }

    h3 {
        font-size: 18px;
        font-weight: 600;
        color: #1c584c;
        text-align: center;
        transition: color 0.3s ease;
        line-height: 1.3;
    }

    p {
        font-size: 14px;
        font-weight: 300;
        color: #666;
        text-align: center;
        line-height: 1.6;
        transition: color 0.3s ease;
    }

    .more {
        display: inline-block;
        margin-top: auto;
        font-size: 13px;
        font-weight: 600;
        color: #1c584c;
        text-decoration: none;
        letter-spacing: 0.02em;
        transition: color 0.3s ease;
    }

    .service-card:hover h3,
    .service-card:hover p,
    .service-card:hover .more {
        color: #fff;
    }

    /* ── MOBILE ── */
    @media (max-width: 900px) {
        .service-card {
            width: 100%;
            max-width: 420px;
            min-height: unset;
        }

        .card-link {
            flex-direction: row;
            align-items: center;
            padding: 20px 22px;
            gap: 18px;
        }

        .icon-wrap {
            width: 56px;
            height: 56px;
            flex-shrink: 0;
        }

        .icon-wrap img { width: 34px; height: 34px; }

        .content { align-items: flex-start; }

        h3 { text-align: left; font-size: 16px; }
        p  { text-align: left; font-size: 13px; }
        .more { font-size: 12px; }
    }
</style>
