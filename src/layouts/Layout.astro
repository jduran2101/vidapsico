---
import { ClientRouter } from "astro:transitions";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Whastapp from "../components/Whastapp.astro";
import SchemaOrg from "../components/SchemaOrg.astro";
import "@fontsource-variable/outfit";

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = "/img/nueva_imagen.png" } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imagenSocial = new URL(image, Astro.site);
---

<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/PsicoVida.png" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="VidaPsico" />
		<meta property="og:locale" content="es_AR" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={imagenSocial} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imagenSocial} />

		<SchemaOrg />
		<ClientRouter />
	</head>
	<body>
		<div class="cuerpo">
			<Header />
			<slot />
			<Whastapp />
			<Footer />
		</div>
	</body>
</html>
<style is:global>
	html {
		font-family: "Outfit Variable", sans-serif;
		background-size: 224px;
	}
	body {
		padding: 0;
		margin: 0;
		box-sizing: border-box;
		background-color: #f5f2ed;
	}

	.cuerpo {
		max-width: 1280px;
		margin: auto;
	}

	h3,
	h2,
	h1,
	h4,
	p {
		padding: 0;
		margin: 0;
	}
</style>
